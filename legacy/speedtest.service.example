[Unit]
Description=Enterprise Network Speedtest
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/speedtest
Environment="PATH=/opt/speedtest/venv/bin"
ExecStart=/opt/speedtest/venv/bin/uvicorn app:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
