#!/bin/sh
set -e

if [ -d /run/systemd/system ]; then
    systemctl --system daemon-reload >/dev/null || true
fi

if [ "$1" = "remove" ] && command -v deb-systemd-helper >/dev/null; then
    deb-systemd-helper mask texas2step.service >/dev/null || true
fi

if [ "$1" = "purge" ]; then
    if command -v deb-systemd-helper >/dev/null; then
        deb-systemd-helper purge texas2step.service >/dev/null || true
        deb-systemd-helper unmask texas2step.service >/dev/null || true
    fi
    # Unattended updates, if they were turned on (systemctl enable).
    rm -f /etc/systemd/system/timers.target.wants/texas2step-update.timer
    # Saved results, and downloads of texas2step update. The texas2step system user is
    # kept, as Debian policy advises.
    rm -rf /var/lib/texas2step /var/cache/texas2step
    # The access key, and the dated backups texas2step config set, add-location and merge
    # --write keep beside the settings file, so dpkg can remove /etc/texas2step. A file
    # the operator put there, such as a logo or their own word list, is kept.
    rm -f /etc/texas2step/access.key /etc/texas2step/access.key.tmp \
        /etc/texas2step/config.toml.tmp \
        /etc/texas2step/config.toml.[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9][0-9][0-9].bak \
        /etc/texas2step/config.toml.[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9][0-9][0-9]-*.bak
fi

exit 0
