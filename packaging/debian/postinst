#!/bin/sh
set -e

if [ "$1" = "configure" ]; then
    if ! getent passwd texas2step >/dev/null; then
        adduser --system --group --home /var/lib/texas2step --no-create-home \
            --quiet texas2step
    fi
    # Byte-compile once here: the service cannot write into /opt at run time.
    /opt/texas2step/venv/bin/python -m compileall -q -j 0 /opt/texas2step/venv/lib \
        >/dev/null 2>&1 || true
    # A random access key of this server's own (docs/access.md), unless it has one: the
    # codes and words an organization uses come from it, so no two installs share them.
    # Readable by root and the service's group only. It stays put on upgrades.
    /opt/texas2step/venv/bin/texas2step access key --init \
        || echo "texas2step: no access key was made; see docs/access.md" >&2
    # The standing phrases, beside it and as private: none yet, two examples commented out.
    /opt/texas2step/venv/bin/texas2step access phrase init >/dev/null \
        || echo "texas2step: no access phrases file was made; see docs/access.md" >&2
fi

# Enable and (re)start the service, as dh_installsystemd would.
if [ "$1" = "configure" ] || [ "$1" = "abort-upgrade" ] || [ "$1" = "abort-deconfigure" ] || [ "$1" = "abort-remove" ]; then
    deb-systemd-helper unmask texas2step.service >/dev/null || true
    if deb-systemd-helper --quiet was-enabled texas2step.service; then
        deb-systemd-helper enable texas2step.service >/dev/null || true
    else
        deb-systemd-helper update-state texas2step.service >/dev/null || true
    fi
    if [ -d /run/systemd/system ]; then
        systemctl --system daemon-reload >/dev/null || true
        if [ -n "$2" ]; then action=restart; else action=start; fi
        deb-systemd-invoke "$action" texas2step.service >/dev/null || true
    fi
fi

# On upgrade, dpkg leaves config.toml.dpkg-dist (the operator kept their file) or
# config.toml.dpkg-old (they took the new one). Either way, point at the merge tool.
if [ "$1" = "configure" ] && [ -n "$2" ]; then
    conf=/etc/texas2step/config.toml
    if [ -e "$conf.dpkg-dist" ]; then
        cat <<MSG
This version's settings template differs from your $conf.
To bring it up to date and keep every value you set, preview the changes, then apply them:
    sudo texas2step config merge
    sudo texas2step config merge --write
MSG
    elif [ -e "$conf.dpkg-old" ]; then
        cat <<MSG
Your previous settings were saved as $conf.dpkg-old. To put your values back
into the new file, preview the changes, then apply them:
    sudo texas2step config merge --from $conf.dpkg-old
    sudo texas2step config merge --from $conf.dpkg-old --write
MSG
    fi
fi

if [ "$1" = "configure" ] && [ -z "$2" ]; then
    # LISTEN_PORT, as texas2step-setup --port may have set it before the install.
    port=$(sed -n 's/^[[:space:]]*LISTEN_PORT=//p' /etc/default/texas2step 2>/dev/null \
        | tail -n 1 | tr -d "\"' ")
    cat <<MSG
texas2step listens on 127.0.0.1:${port:-8080} (systemctl status texas2step). To publish
it at /texas2step/ on your site, add
    include snippets/texas2step.conf;
to your site's server { } block in /etc/nginx/sites-available/, then run
    sudo nginx -t && sudo systemctl reload nginx
MSG
fi

exit 0
